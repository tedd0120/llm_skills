# ============================================================
# LLM Agent Skills Hub — 环境变量配置模板
# 复制为 .env 后填入实际值即可（.env 已在 .gitignore 中忽略）
# ============================================================

# ---- 123云盘 (pan123-renamer) ----
# 凭证申请：https://www.123pan.com/developer（免审核）
PAN123_CLIENT_ID=
PAN123_CLIENT_SECRET=

# ---- 360Teams 考勤 (teams-attendance) ----
TEAMS_EM_CODE=你的员工编码
TEAMS_AUTHORIZATION=你的授权令牌

# ---- 360Teams 群组成员 (teams-group-members) ----
# TEAMS_AUTHORIZATION 同上，无需重复配置
TEAMS_GROUP_CODES=群组A,群组B,群组C

# ---- LiteLLM 网关测速 (litellm-model-speedtest) ----
LLM_API_KEY=
# LLM_PROXY=http://127.0.0.1:7897
