# Teams 相关技能 (teams-attendance, teams-group-members)
TEAMS_EM_CODE=你的员工编码
TEAMS_AUTHORIZATION=你的授权令牌
TEAMS_GROUP_CODES=群组A,群组B,群组C

# 123云盘开放平台 (pan123-renamer)
# 申请地址：https://www.123pan.com/developer （免审核）
PAN123_CLIENT_ID=你的clientID
PAN123_CLIENT_SECRET=你的clientSecret

# Tavily MCP (实时 Web 搜索/抓取)
# 申请地址：https://app.tavily.com/home （免费额度）
# 注：ZCode MCP 不自动读取本文件，需写入：.zcode/config.json -> mcp.servers.tavily-mcp.env.TAVILY_API_KEY
TAVILY_API_KEY=your_tavily_api_key_here