{
  "_doc": "扫描器与分类共用的已知路径表。match 为名称 glob（任意层级）或以 / 开头的仓库相对路径；top_only 表示只在仓库根匹配；layer 取 asset|work|local|program|secret|legacy|ask；ignore 取 yes|no|ask；migrate_to 仅 legacy 使用。",
  "entries": [
    {"match": "/.work", "layer": "work", "ignore": "yes", "note": "任务工作区"},
    {"match": ".local", "layer": "local", "ignore": "yes", "note": "本机持久状态；非根层级的 .local 属于所在模块，询问是否并入根 .local"},

    {"match": ".tmp", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/scratch/"},
    {"match": "tmp", "top_only": true, "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/scratch/"},
    {"match": "temp", "top_only": true, "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/scratch/"},
    {"match": ".temp", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/scratch/"},
    {"match": ".scratch", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/scratch/"},
    {"match": ".prototypes", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/prototype/"},
    {"match": ".prototype", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/prototype/"},
    {"match": "prototypes", "top_only": true, "layer": "ask", "ignore": "ask", "migrate_to": ".work/<任务ID>/prototype/", "note": "可能是被跟踪的正式示例"},
    {"match": ".task-runner", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/runner/"},
    {"match": "plans", "top_only": true, "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/plan.md"},
    {"match": "/docs/plans", "layer": "ask", "ignore": "ask", "migrate_to": ".work/<任务ID>/plan.md", "note": "被跟踪时可能是正式设计文档"},
    {"match": ".brainstorm", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/scratch/"},
    {"match": ".frontend-slides", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/scratch/"},
    {"match": ".agent-council", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/scratch/"},
    {"match": ".pi-council", "layer": "legacy", "ignore": "yes", "migrate_to": ".work/<任务ID>/scratch/"},

    {"match": "node_modules", "layer": "program", "ignore": "yes", "heavy": true},
    {"match": ".venv", "layer": "program", "ignore": "yes", "heavy": true},
    {"match": "venv", "top_only": true, "layer": "program", "ignore": "yes", "heavy": true},
    {"match": "__pycache__", "layer": "program", "ignore": "yes"},
    {"match": ".pytest_cache", "layer": "program", "ignore": "yes"},
    {"match": ".mypy_cache", "layer": "program", "ignore": "yes"},
    {"match": ".ruff_cache", "layer": "program", "ignore": "yes"},
    {"match": ".tox", "layer": "program", "ignore": "yes", "heavy": true},
    {"match": ".vite", "layer": "program", "ignore": "yes"},
    {"match": ".next", "layer": "program", "ignore": "yes", "heavy": true},
    {"match": ".nuxt", "layer": "program", "ignore": "yes", "heavy": true},
    {"match": ".turbo", "layer": "program", "ignore": "yes"},
    {"match": ".parcel-cache", "layer": "program", "ignore": "yes"},
    {"match": ".gradle", "layer": "program", "ignore": "yes", "heavy": true},
    {"match": ".cache", "layer": "program", "ignore": "yes"},
    {"match": "coverage", "layer": "program", "ignore": "yes"},
    {"match": "htmlcov", "layer": "program", "ignore": "yes"},
    {"match": "test-results*", "layer": "program", "ignore": "yes"},
    {"match": "playwright-report", "layer": "program", "ignore": "yes"},
    {"match": "blob-report", "layer": "program", "ignore": "yes"},
    {"match": "dist", "layer": "program", "ignore": "yes"},
    {"match": "build", "top_only": true, "layer": "ask", "ignore": "ask", "note": "可能是构建产物，也可能是构建脚本源码"},
    {"match": "target", "top_only": true, "layer": "ask", "ignore": "ask", "note": "Rust/Java 构建产物或同名源码目录"},
    {"match": ".codegraph", "layer": "program", "ignore": "yes"},
    {"match": ".pi", "top_only": true, "layer": "program", "ignore": "yes", "note": "AI 客户端本机状态"},
    {"match": ".zcode", "top_only": true, "layer": "program", "ignore": "yes", "note": "AI 客户端本机状态，可能含明文密钥"},
    {"match": ".idea", "top_only": true, "layer": "program", "ignore": "yes"},
    {"match": ".claude", "top_only": true, "layer": "ask", "ignore": "ask", "note": "settings.json/commands 可能需团队共享，settings.local.json 为本机"},
    {"match": ".codex", "top_only": true, "layer": "ask", "ignore": "ask", "note": "项目级 Codex 配置可能需共享"},
    {"match": ".cursor", "top_only": true, "layer": "ask", "ignore": "ask", "note": "rules 可能需共享"},
    {"match": ".vscode", "top_only": true, "layer": "ask", "ignore": "ask", "note": "推荐扩展与任务配置可能需共享"},

    {"match": ".env", "layer": "secret", "ignore": "yes"},
    {"match": ".env.*", "layer": "secret", "ignore": "yes", "note": ".env.example 等模板例外，需跟踪"},
    {"match": "*.pem", "layer": "secret", "ignore": "yes"},
    {"match": "*.key", "layer": "secret", "ignore": "yes"},
    {"match": "*.local.*", "layer": "secret", "ignore": "yes", "note": "本机配置，常含连接参数"},

    {"match": "/.git", "layer": "program", "ignore": "no", "skip": true},
    {"match": "/.agents", "layer": "asset", "ignore": "no"},
    {"match": "/.github", "layer": "asset", "ignore": "no"},
    {"match": "/.gitignore", "layer": "asset", "ignore": "no"},
    {"match": "/.gitattributes", "layer": "asset", "ignore": "no"},
    {"match": "/AGENTS.md", "layer": "asset", "ignore": "no"},
    {"match": "/CLAUDE.md", "layer": "asset", "ignore": "no"},
    {"match": "/CONTEXT.md", "layer": "asset", "ignore": "no"},
    {"match": "/CONTEXT-MAP.md", "layer": "asset", "ignore": "no"},
    {"match": "/README*", "layer": "asset", "ignore": "no"},
    {"match": "/docs", "layer": "asset", "ignore": "no"},
    {"match": "/src", "layer": "asset", "ignore": "no"},
    {"match": "/tests", "layer": "asset", "ignore": "no"},
    {"match": "/test", "layer": "asset", "ignore": "no"},
    {"match": "/scripts", "layer": "asset", "ignore": "no"},
    {"match": "/tools", "layer": "asset", "ignore": "no"},

    {"match": "data", "top_only": true, "layer": "ask", "ignore": "ask", "note": "业务数据、夹具或 skill 产出"},
    {"match": "datasets", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "input", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "inputs", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "output", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "outputs", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "results", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "reports", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "logs", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "runs", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "artifacts", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "experiments", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "notebooks", "top_only": true, "layer": "ask", "ignore": "ask"},
    {"match": "configs", "top_only": true, "layer": "ask", "ignore": "ask", "note": "常见模板跟踪、实值忽略的混合目录"},
    {"match": "config", "top_only": true, "layer": "ask", "ignore": "ask", "note": "常见模板跟踪、实值忽略的混合目录"}
  ]
}
